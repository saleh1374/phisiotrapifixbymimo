# --- Django core ---
# کلید امنیتی: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database ---
# postgres (default) or sqlite3 (quick local dev without PostgreSQL)
DATABASE_ENGINE=postgres
POSTGRES_DB=physio_clinic
POSTGRES_USER=physio
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0

# --- CORS (Next.js frontend) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Google sign-in (ورود با گوگل) ---
# از https://console.cloud.google.com/apis/credentials یک OAuth Client ID بسازید
GOOGLE_CLIENT_ID=

# --- OTP / SMS (اختیاری — ورود با شماره موبایل) ---
# console = print code to server log (development). Production: kavenegar etc.
OTP_SMS_BACKEND=console
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
